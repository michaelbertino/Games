@@ -299,6 +299,17 @@ pub fn discover_ports() -> Result<Vec<String>, BackupError> {
         })
         .collect::<Vec<_>>();
     matches.sort();
+    // macOS exposes call-in and call-out aliases for the same USB device.
+    // Prefer the call-out endpoint, retaining tty when no paired cu exists.
+    #[cfg(target_os = "macos")]
+    {
+        let names = matches.clone();
+        matches.retain(|name| {
+            name.strip_prefix("/dev/tty.").is_none_or(|suffix| {
+                !names.contains(&format!("/dev/cu.{suffix}"))
+            })
+        });
+    }
     Ok(matches)
 }
 
